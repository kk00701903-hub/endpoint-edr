# Supabase (대시보드 > Project Settings > API). anon 키만 사용 — service_role 키를 넣지 마세요.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 1 이면 Supabase 없이 내장 예시 데이터로 화면을 띄웁니다(로그인 없음). 화면 확인·시연용.
EDR_DEMO=0

# 회사 계정(SSO) 로그인 — 설정하면 로그인 화면에 버튼이 생긴다. 실험 절차: docs/SSO_LAB.md
#   개인 PC 실험 구성에서는 직접 쓰지 말고 `node deploy/sso-lab/lab.mjs on|off` 로 켜고 끈다(이 파일의 .env.local 에 구간을 넣고 뺀다)
#   Supabase 쪽 공급자 이름(로컬은 supabase/config.toml 의 [auth.external.keycloak])
# NEXT_PUBLIC_SSO_PROVIDER=keycloak
# NEXT_PUBLIC_SSO_LABEL=회사 계정으로 로그인
#   로그아웃할 때 Keycloak 세션도 끝내기(다른 계정으로 로그인할 수 있게)
# SSO_LOGOUT_URL=http://host.docker.internal:8080/realms/bing/protocol/openid-connect/logout?client_id=edr-console&post_logout_redirect_uri=http%3A%2F%2Flocalhost%3A3000%2Flogin
