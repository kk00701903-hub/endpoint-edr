# ---- 도메인 ----
INGEST_DOMAIN=ingest.example.com
GRAFANA_DOMAIN=grafana.example.com
CONSOLE_DOMAIN=edr.example.com

# ---- 관리 콘솔 (Supabase 대시보드 > Project Settings > API) — anon 키만. service_role 금지 ----
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# ---- Supabase Postgres 접속 ----
# Supabase 대시보드 > Project Settings > Database 의 호스트. 전용 역할로 접속한다(service_role/postgres 사용 금지).
#   준비: SQL Editor 에서  alter role edr_ingest with login password '...';  (enricher, grafana_reader 도 동일)
# Supabase 연결 풀러를 쓸 때는 사용자명이 "역할.프로젝트ref" 형태가 될 수 있다(대시보드 안내 확인).
PG_HOST=db.xxxxxxxxxxxx.supabase.co
PG_DB=postgres
INGEST_DATABASE_URL=postgres://edr_ingest:CHANGE_ME@db.xxxxxxxxxxxx.supabase.co:5432/postgres?sslmode=require
ENRICHER_DATABASE_URL=postgres://edr_enricher:CHANGE_ME@db.xxxxxxxxxxxx.supabase.co:5432/postgres?sslmode=require
PG_GRAFANA_USER=grafana_reader
PG_GRAFANA_PASSWORD=CHANGE_ME

# ---- 위협 인텔리전스 (선택) ----
# ⚠ VirusTotal Public API 는 분당 4회·하루 500회 제한, 업무용 사용 제한 조항이 있으니 약관 확인 후 사용(필요 시 유료 계약).
VT_API_KEY=
VT_REQUESTS_PER_MIN=4
MALWAREBAZAAR_AUTH_KEY=
RUN_DETECTIONS=0

# ---- 알림 연동 (슬랙·이메일·SIEM) ----
# enricher 가 경보를 콘솔 설정의 채널로 내보낸다. 기본 켜짐(끄려면 RUN_NOTIFIER=0).
RUN_NOTIFIER=1
# 슬랙/웹훅: 콘솔 채널의 "비밀값 .env 키 이름"(secret_ref)이 가리키는 변수에 실제 URL 을 넣는다.
#   예) 콘솔에서 secret_ref=SLACK_WEBHOOK_SOC 로 만들었다면 아래처럼:
# SLACK_WEBHOOK_SOC=https://hooks.slack.com/services/XXX/YYY/ZZZ
# 이메일(SMTP) 공통 설정. 채널의 "대상"에 받는 주소(쉼표로 여러 명)를 넣는다.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=edr-alert@bing.co.kr
SMTP_USER=
SMTP_PASS=
# SIEM(syslog): 채널의 "대상"에 host:port (TCP 는 뒤에 /tcp). 추가 .env 설정 없음.

# ---- Wazuh 경보 수집 (선택, 외부 오픈소스 EDR 연동) ----
# 둘 다 채워야 수집 서버의 POST /v1/wazuh 웹훅이 열린다. 설정은 deploy/wazuh/README.md.
WAZUH_WEBHOOK_SECRET=
WAZUH_TENANT_ID=

# ---- Grafana ----
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
ALERT_WEBHOOK_URL=
